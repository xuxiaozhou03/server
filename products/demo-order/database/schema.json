{
  "name": "order_center",
  "dialect": "PostgreSQL 16",
  "description": "订单中心的设计基线：客户、订单、订单明细、履约动态和跟进记录围绕订单聚合组织。金额使用整数最小货币单位，状态使用受控枚举。",
  "principles": [
    "订单是聚合根，明细与活动记录通过 order_id 归属订单",
    "订单号对外唯一，主键使用不可变的业务前缀 ID",
    "金额统一以分存储，避免浮点误差",
    "状态变更与跟进动作写入活动流水，保留审计上下文",
    "高频筛选字段建立组合索引，列表查询避免全表扫描"
  ],
  "tables": [
    {
      "name": "customers",
      "label": "客户",
      "description": "下单主体与客户档案，订单通过 customer_id 关联到客户。",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "key": "PK", "description": "客户主键" },
        { "name": "name", "type": "varchar(80)", "nullable": false, "description": "客户显示名称" },
        { "name": "email", "type": "varchar(160)", "nullable": false, "unique": true, "description": "邮箱，全局唯一" },
        { "name": "phone", "type": "varchar(32)", "nullable": true, "description": "联系电话，展示时脱敏" },
        { "name": "company", "type": "varchar(120)", "nullable": true, "description": "企业客户名称" },
        { "name": "level", "type": "customer_level", "nullable": false, "default": "'regular'", "description": "regular / vip / enterprise" },
        { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间" },
        { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间" }
      ],
      "indexes": [
        { "name": "idx_customers_email", "columns": ["email"], "unique": true, "reason": "登录和客户检索" },
        { "name": "idx_customers_level_created", "columns": ["level", "created_at DESC"], "unique": false, "reason": "客户分层列表" }
      ]
    },
    {
      "name": "orders",
      "label": "订单",
      "description": "订单聚合根，保存金额、付款、履约和跟进状态。",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "key": "PK", "description": "订单主键" },
        { "name": "order_no", "type": "varchar(32)", "nullable": false, "unique": true, "description": "对外订单号" },
        { "name": "customer_id", "type": "uuid", "nullable": false, "key": "FK", "references": "customers.id", "description": "下单客户" },
        { "name": "status", "type": "order_status", "nullable": false, "default": "'pending'", "description": "pending / processing / shipped / completed / cancelled" },
        { "name": "payment_status", "type": "payment_status", "nullable": false, "default": "'unpaid'", "description": "unpaid / paid / refunded" },
        { "name": "total_amount", "type": "bigint", "nullable": false, "description": "订单总额，单位为分" },
        { "name": "currency", "type": "char(3)", "nullable": false, "default": "'CNY'", "description": "ISO 货币代码" },
        { "name": "assignee", "type": "varchar(80)", "nullable": true, "description": "当前跟进人" },
        { "name": "note", "type": "text", "nullable": true, "description": "订单备注" },
        { "name": "shipping_address", "type": "text", "nullable": true, "description": "收货地址快照" },
        { "name": "followed_up_at", "type": "timestamptz", "nullable": true, "description": "最近跟进时间" },
        { "name": "version", "type": "integer", "nullable": false, "default": "1", "description": "乐观锁版本号" },
        { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间" },
        { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间" }
      ],
      "indexes": [
        { "name": "uq_orders_order_no", "columns": ["order_no"], "unique": true, "reason": "订单号唯一" },
        { "name": "idx_orders_status_created", "columns": ["status", "created_at DESC"], "unique": false, "reason": "状态列表与默认倒序" },
        { "name": "idx_orders_customer_created", "columns": ["customer_id", "created_at DESC"], "unique": false, "reason": "客户详情关联订单" },
        { "name": "idx_orders_followed_up", "columns": ["followed_up_at"], "unique": false, "reason": "待跟进筛选" }
      ]
    },
    {
      "name": "order_items",
      "label": "订单明细",
      "description": "订单中的商品快照，保存下单时的名称、单价与数量。",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "key": "PK", "description": "明细主键" },
        { "name": "order_id", "type": "uuid", "nullable": false, "key": "FK", "references": "orders.id", "description": "所属订单" },
        { "name": "sku", "type": "varchar(64)", "nullable": false, "description": "商品 SKU 快照" },
        { "name": "product_name", "type": "varchar(160)", "nullable": false, "description": "商品名称快照" },
        { "name": "unit_price", "type": "bigint", "nullable": false, "description": "单价，单位为分" },
        { "name": "quantity", "type": "integer", "nullable": false, "description": "购买数量，必须大于 0" },
        { "name": "subtotal", "type": "bigint", "nullable": false, "description": "行小计，单位为分" }
      ],
      "indexes": [
        { "name": "idx_order_items_order", "columns": ["order_id"], "unique": false, "reason": "订单详情聚合" },
        { "name": "idx_order_items_sku", "columns": ["sku"], "unique": false, "reason": "商品维度检索" }
      ]
    },
    {
      "name": "order_activities",
      "label": "订单动态",
      "description": "不可变的订单活动流水，用于详情时间线和操作审计。",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "key": "PK", "description": "动态主键" },
        { "name": "order_id", "type": "uuid", "nullable": false, "key": "FK", "references": "orders.id", "description": "所属订单" },
        { "name": "type", "type": "activity_type", "nullable": false, "description": "created / status_changed / note_added / followed_up" },
        { "name": "actor", "type": "varchar(80)", "nullable": false, "description": "操作人或系统" },
        { "name": "content", "type": "text", "nullable": false, "description": "可读的操作内容" },
        { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "发生时间" }
      ],
      "indexes": [
        { "name": "idx_activities_order_created", "columns": ["order_id", "created_at DESC"], "unique": false, "reason": "订单时间线" }
      ]
    },
    {
      "name": "follow_ups",
      "label": "跟进记录",
      "description": "运营对订单的结构化跟进记录，与订单动态互补。",
      "columns": [
        { "name": "id", "type": "uuid", "nullable": false, "key": "PK", "description": "跟进记录主键" },
        { "name": "order_id", "type": "uuid", "nullable": false, "key": "FK", "references": "orders.id", "description": "所属订单" },
        { "name": "assignee", "type": "varchar(80)", "nullable": false, "description": "跟进人" },
        { "name": "note", "type": "text", "nullable": true, "description": "跟进备注" },
        { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "跟进时间" }
      ],
      "indexes": [
        { "name": "idx_follow_ups_order_created", "columns": ["order_id", "created_at DESC"], "unique": false, "reason": "订单跟进历史" }
      ]
    }
  ],
  "relations": [
    { "from": "orders.customer_id", "to": "customers.id", "cardinality": "N:1", "label": "客户拥有多个订单", "onDelete": "RESTRICT" },
    { "from": "order_items.order_id", "to": "orders.id", "cardinality": "N:1", "label": "订单包含多个明细", "onDelete": "CASCADE" },
    { "from": "order_activities.order_id", "to": "orders.id", "cardinality": "N:1", "label": "订单拥有活动流水", "onDelete": "CASCADE" },
    { "from": "follow_ups.order_id", "to": "orders.id", "cardinality": "N:1", "label": "订单拥有跟进记录", "onDelete": "CASCADE" }
  ]
}
